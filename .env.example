# Copy to .env and fill in. Never commit .env.

# Public domain name pointing at this server (for the HTTPS certificate).
DOMAIN=voxora.example.edu

# Database passwords: use long random values, e.g. `openssl rand -base64 24`.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# First administrator account, created on first start if it doesn't exist.
# Password: at least 12 characters. Remove ADMIN_PASSWORD after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
